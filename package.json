{
  "name": "app",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "lint": "vp lint",
    "check:workflows": "node scripts/check-workflows.ts",
    "serve": "vp build && node scripts/serve.ts",
    "build:bin": "node scripts/build-bin.ts",
    "release:dry": "semantic-release --dry-run --no-ci",
    "preview": "vp preview",
    "prepare": "vp config",
    "e2e": "playwright test --project=chromium --project=firefox",
    "shots": "vp build && node scripts/shots.ts",
    "e2e:local": "playwright test && vp run shots"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.2.0",
    "geist": "^1.7.2",
    "postprocessing": "6.39.5",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "three": "0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  }
}
